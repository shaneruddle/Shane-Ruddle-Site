rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.uid == "u7ElWXIkdjVTNTp76LcyXnnq3AM2") ||
        (request.auth.token.email.lower() == "shaneruddle@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    function isManager() {
      return isAuthenticated() && (
        (request.auth.uid == "u7ElWXIkdjVTNTp76LcyXnnq3AM2") ||
        (request.auth.token.email.lower() == "shaneruddle@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'manager' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'manager' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    function isFinanceUser() {
      return isAuthenticated() && (
        (request.auth.uid == "u7ElWXIkdjVTNTp76LcyXnnq3AM2") ||
        (request.auth.token.email.lower() == "shaneruddle@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'accounts' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'accounts' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      );
    }

    function isValidFinanceTransaction(data) {
      return data.keys().hasAll(['section', 'type', 'date', 'description', 'amount', 'agent', 'dealType']) &&
             data.section in ['ABPC', 'ECRE'] &&
             data.type in ['income', 'expense'] &&
             data.date is string &&
             data.description is string &&
             data.amount is number &&
             data.agent is string &&
             data.dealType in ['new', 'renewal', '-', 'RENEWAL'];
    }

    function isValidUser(data) {
      return (data.uid is string || !('uid' in data)) &&
             (data.email is string || !('email' in data) || data.email == null);
    }

    function isValidUsageLog(data) {
      return data.keys().hasAll(['userId', 'timestamp']) &&
             data.userId == request.auth.uid;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'body', 'category']) &&
             data.title is string && data.body is string && 
             data.category in ["My Advice", "Property", "Car Rental", "Pattaya News"];
    }

    function isValidExtraction(data) {
      return data.keys().hasAll(['userId', 'url', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.url is string &&
             (data.timestamp is timestamp || data.timestamp is string) &&
             (!('refNumber' in data) || data.refNumber is string || data.refNumber == null) &&
             (!('bubbleStatus' in data) || data.bubbleStatus is string || data.bubbleStatus == null);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        ((isManager() || isFinanceUser()) && (
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '---') ||
          resource.data.get('company', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('company', '---')
        ))
      );

      allow create: if (isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        (request.resource.data.get('active', false) is bool && 
         (request.resource.data.get('roles', ['employee']) == ['employee'] || 
          request.resource.data.get('role', 'employee') == 'employee'))
      )) && isValidUser(request.resource.data);

      allow update: if (isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'role', 'active'])
      )) && isValidUser(request.resource.data);

      allow delete: if isAdmin() || (
        isAuthenticated() && 
        request.auth.token.email.lower() == resource.data.get('email', '').lower()
      );
    }

    match /discounts/{discountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usage_logs/{logId} {
      allow read: if isAdmin() || isManager() || isFinanceUser() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidUsageLog(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBlogPost(request.resource.data);
    }

    match /finance/{transactionId} {
      allow read: if isFinanceUser() || isManager();
      allow create, update: if isFinanceUser() && isValidFinanceTransaction(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /extractions/{extractionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidExtraction(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
