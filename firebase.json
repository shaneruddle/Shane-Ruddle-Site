{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "shane-ruddle-site",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.* ",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/questions/thai-retirement-visa-requirements",
        "destination": "/thai-visas/retirement-visa",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/mcp",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/oauth/**",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/**",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server/**",
        "run": {
          "serviceId": "shane-ruddle-server",
          "region": "asia-east1"
        }
      },
      {
        "source": "/portal",
        "destination": "/app.html"
      },
      {
        "source": "/portal/**",
        "destination": "/app.html"
      },
      {
        "source": "/inbox",
        "destination": "/inbox.html"
      },
      {
        "source": "/staff-check",
        "destination": "/staff-check.html"
      },
      {
        "source": "/inbox/**",
        "destination": "/app.html"
      },
      {
        "source": "/articles/**",
        "destination": "/app.html"
      },
      {
        "source": "/de/artikel/**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/staff-check",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/inbox-sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "trailingSlash": false
  }
}
