rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Matches the owner checks in firestore.rules isAdmin().
    function isOwner() {
      return request.auth != null && (
        request.auth.uid == "u7ElWXIkdjVTNTp76LcyXnnq3AM2" ||
        request.auth.token.email.lower() == "shaneruddle@gmail.com"
      );
    }

    // Photo library (portal Photos tab): public to read, owner-only to upload or delete.
    match /site-photos/{file} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner();
    }

    // Legacy images: still publicly readable, owner-only writes.
    match /site_images/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
